# ===========================================
# Environment Variables for Rutwik's Portfolio
# ===========================================
# Copy this file to .env.local and fill in the values

# AI Chat. Set at least one; with both, Gemini answers first and Groq takes
# over whenever Gemini refuses (quota, outage), so visitors rarely see "busy".
# Both are free tiers.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: the Gemini models to try, in order. Each has its own free quota.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Resend API Key (Required for Contact Form)
# Get your API key from: https://resend.com/api-keys
# Free tier: 100 emails/day, 3000 emails/month
RESEND_API_KEY=your_resend_api_key_here

# Contact Email (Optional - defaults to rutwikdh@usc.edu)
# CONTACT_EMAIL=your_email@example.com

# Optional: Analytics (Vercel Analytics is auto-configured)
# NEXT_PUBLIC_ANALYTICS_ID=

# Optional: Site URL for SEO
# NEXT_PUBLIC_SITE_URL=https://rutwik.dev


# Analytics Dashboard (Required to open /admin/analytics)
# Any long random string. Without it the dashboard stays closed, not open.
# Generate one with: openssl rand -hex 32
ANALYTICS_ADMIN_TOKEN=

# Visitor Hash Salt (Optional but recommended)
# Salts the per-visitor key on /api/stats so the stored digest cannot be
# reversed by hashing the candidate IP space. Generate with: openssl rand -hex 16
VISITOR_HASH_SALT=
