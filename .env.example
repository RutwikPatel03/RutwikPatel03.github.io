# ===========================================
# Environment Variables for Rutwik's Portfolio
# ===========================================
# Copy this file to .env.local and fill in the values

# Groq API Key (Required for AI Chat feature)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Resend API Key (Required for Contact Form)
# Get your API key from: https://resend.com/api-keys
# Free tier: 100 emails/day, 3000 emails/month
RESEND_API_KEY=your_resend_api_key_here

# Contact Email (Optional - defaults to rutwikdh@usc.edu)
# CONTACT_EMAIL=your_email@example.com

# Optional: Analytics (Vercel Analytics is auto-configured)
# NEXT_PUBLIC_ANALYTICS_ID=

# Optional: Site URL for SEO
# NEXT_PUBLIC_SITE_URL=https://rutwik.dev

